{
  "services": {
    "murthy-ac-platform": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "murthy-ac-platform"
      }
    }
  ]
}
